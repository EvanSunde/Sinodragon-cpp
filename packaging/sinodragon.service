# systemd user unit for the Sinodragon keyboard lighting daemon.
#
#   mkdir -p ~/.config/systemd/user
#   cp packaging/sinodragon.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sinodragon
#
# The daemon needs read access to /dev/hidrawN and /dev/input/event*; install
# packaging/70-sinodragon.rules first or it will start and find no device.

[Unit]
Description=Sinodragon keyboard RGB daemon
Documentation=https://github.com/EvanSunde/Sinodragon-cpp
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sinodragon --daemon
ExecReload=/usr/local/bin/sinoctl reload

# The daemon reconnects on its own when the keyboard is unplugged, so a restart
# here is only for an outright crash.
Restart=on-failure
RestartSec=5s

# It talks to one HID device, its unix control socket, and -- for Chroma
# games -- a TCP socket bound to 127.0.0.1:54235. AF_INET is needed for that
# last one alone; without it the Chroma server fails with "Address family not
# supported by protocol". Drop AF_INET if you run with --no-chroma.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
MemoryDenyWriteExecute=true
RuntimeDirectory=sinodragon

[Install]
WantedBy=graphical-session.target
