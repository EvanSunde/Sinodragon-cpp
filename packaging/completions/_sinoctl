#compdef sinoctl sinodragon
# zsh completion for sinoctl / sinodragon.
#
#   mkdir -p ~/.zfuncs && cp _sinoctl ~/.zfuncs/
#   # in ~/.zshrc, before compinit:
#   fpath=(~/.zfuncs $fpath)
#
# Profile and game names are read from the running daemon.

_sinoctl_ask() {
  local -a items
  items=(${(f)"$(sinoctl complete $1 2>/dev/null)"})
  print -l -- $items
}

_sinoctl_main() {
  local -a commands
  commands=(${(f)"$(_sinoctl_ask commands)"})

  _arguments -C \
    '(-s --socket)'{-s,--socket}'[control socket]:socket:_files' \
    '(-h --help)'{-h,--help}'[show help]' \
    '1: :->command' \
    '*:: :->args' && return 0

  case $state in
    command) _describe -t commands 'sinoctl command' commands ;;
    args)
      case $words[1] in
        profile)
          if (( CURRENT == 2 )); then
            local -a profiles; profiles=(${(f)"$(_sinoctl_ask profiles)"})
            _describe -t profiles 'profile' profiles
          elif (( CURRENT == 3 )); then
            _values 'hold' 'for'
          elif (( CURRENT == 4 )); then
            _values 'duration' '10s' '30s' '1m' '5m' '30m' '1h'
          fi ;;
        game)
          if (( CURRENT == 2 )); then
            local -a games; games=(${(f)"$(_sinoctl_ask games)"} list stop)
            _describe -t games 'game' games
          elif (( CURRENT == 3 )); then
            _values 'action' 'start' 'stop'
          fi ;;
        state)   (( CURRENT == 3 )) && _values 'state' 'ok' 'warn' 'fail' 'busy' 'off' ;;
        watch)   _values 'watch' 'on' 'off' ;;
        brightness) _values 'brightness' '0' '25' '50' '75' '100' ;;
        complete)   _values 'what' 'commands' 'profiles' 'games' ;;
      esac ;;
  esac
}

_sinodragon_main() {
  _arguments \
    '(-c --config)'{-c,--config}'[config file]:config:_files -g "*.toml"' \
    '(-d --daemon)'{-d,--daemon}'[run without the interactive prompt]' \
    '(-p --preview)'{-p,--preview}'[draw frames in the terminal]' \
    '(-s --socket)'{-s,--socket}'[control socket]:socket:_files' \
    '--no-socket[do not listen for control commands]' \
    '--lock[single-instance lock file]:lock:_files' \
    '--no-lock[allow more than one instance]' \
    '(-h --help)'{-h,--help}'[show help]' \
    '(-v --version)'{-v,--version}'[show the version]' \
    '*:config:_files -g "*.toml"'
}

case $service in
  sinodragon) _sinodragon_main "$@" ;;
  *)          _sinoctl_main "$@" ;;
esac
