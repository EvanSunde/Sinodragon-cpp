# udev rules for the Sinodragon keyboard RGB daemon.
#
#   sudo cp packaging/99-sinodragon.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Without these the daemon has to run as root: hidraw nodes and
# /dev/input/event* are both root-only by default on most distributions.

# 1. The LED interface. Redragon keyboards report vendor 0x258a.
#    Add a line for your own board if the vendor id differs; `lsusb` shows it.
KERNEL=="hidraw*", ATTRS{idVendor}=="258a", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="258a", MODE="0660", TAG+="uaccess"

# 2. Keyboard event devices, needed for the reactive effects, the shortcut
#    overlay and the games. TAG+="uaccess" grants the locally logged-in user
#    access via systemd-logind, which is preferable to adding yourself to the
#    'input' group -- that would give every process you run a keylogger.
KERNEL=="event*", ATTRS{idVendor}=="258a", TAG+="uaccess"

# If your keyboard is not a 258a device, or you use a laptop's built-in
# keyboard for input while lighting an external board, match on the keyboard
# capability instead:
# KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess"
